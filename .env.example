# =============================================================================
# MallMind — environment variables template
# =============================================================================
# Copy to `.env` and fill in. Do NOT commit `.env`.
#
# All variables listed here are consumed by `docker-compose.yml`.
# Backend-only variables are also loaded from `.env` by pydantic-settings
# when the backend runs outside Docker (e.g. `uvicorn --reload` locally).
# =============================================================================

# ---- Postgres ---------------------------------------------------------------
# Used by the postgres service and composed into DATABASE_URL for the backend.
POSTGRES_USER=mallmind
POSTGRES_PASSWORD=mallmind_dev_only
POSTGRES_DB=mallmind

# ---- Backend ----------------------------------------------------------------
# When running inside Docker Compose, the host is `postgres` (the service name).
# When running the backend locally against a Compose-managed DB, use `localhost`.
DATABASE_URL=postgresql+asyncpg://mallmind:mallmind_dev_only@postgres:5432/mallmind
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ---------------------------------------------------------------
# Where the browser (running on the host) reaches the backend.
# NOTE: this is read at BUILD time by Next.js for client bundles, so a change
# requires a rebuild of the frontend image.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- LLM provider (Phase 5 — not needed until then) -------------------------
# LLM_PROVIDER=groq
# LLM_API_KEY=
# EMBEDDING_MODEL=
